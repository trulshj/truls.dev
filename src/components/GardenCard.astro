---
import CodeBadge from "./CodeBadge.astro";
import Mosaic from "./Mosaic.astro";
import Stamp from "./Stamp.astro";
import {
    LANG_LABELS,
    TYPE_LABELS,
    formatDate,
    slugOf,
    splitTitle,
    titleSize,
    type GardenPost,
    type StationCode,
} from "../lib/garden";

export type Props = {
    post: GardenPost;
    code?: StationCode;
    /** The big 2×2 card at the start of the garden grid. */
    feature?: boolean;
};

const { post, code, feature = false } = Astro.props;
const { title, titleJa, excerpt, type, lang, status, pubDate, tags = [], image } = post.data;
const slug = slugOf(post);
const href = `/garden/${slug}`;
const typeLabel = TYPE_LABELS[type];
const langLabel = LANG_LABELS[lang];
const lines = splitTitle(title);
---

<article
    class:list={["card", { "card--feature": feature }]}
    data-type={type}
    data-lang={lang}
    data-status={status}
    transition:name={`post-${slug}`}
>
    <span class="card-stamp"><Stamp status={status} size={feature ? 72 : 46} /></span>

    <header class="card-head">
        <CodeBadge code={code} />
        <span class="card-type">
            {typeLabel.no}
            <span lang="ja">{typeLabel.ja}</span>
        </span>
        {!feature && <Mosaic seed={slug} cols={4} rows={2} tile={11} density={0.95} colors={["ink", "t", "taupe", "paper"]} />}
    </header>

    {/* the cover image, or the post's own tile pattern when it has none */}
    {feature && image && <img class="card-cover-img" src={image.src} alt={image.alt} loading="lazy" />}
    {
        feature && !image && (
            <Mosaic
                class="card-cover"
                seed={slug}
                cols={20}
                rows={5}
                tile={24}
                density={0.85}
                anchor={[0.5, 0.5]}
                colors={["ink", "t", "taupe", "paper"]}
            />
        )
    }

    {
        feature ? (
            <h3 class="block-title card-block-title" style={`--title-size: ${titleSize(lines, 560, 66, 70)}`}>
                <a href={href} class="card-link" aria-label={title}>
                    {lines.map((line) => <span class="bt">{line}</span>)}
                </a>
            </h3>
        ) : (
            <h3 class="card-title">
                <a href={href} class="card-link">{title}</a>
            </h3>
        )
    }
    {titleJa && <p class="card-title-ja" lang="ja">{titleJa}</p>}

    {excerpt && <p class="card-excerpt">{excerpt}</p>}

    <footer class="card-foot">
        <span class="lang" title={`${langLabel.no} · ${langLabel.ja}`}>{langLabel.code}</span>
        {tags.slice(0, feature ? 6 : 3).map((tag) => <span class="tag">#{tag}</span>)}
        <time datetime={pubDate.toISOString()}>{formatDate(pubDate, true)}</time>
    </footer>
</article>
