---
import type { StationCode } from "../lib/garden";

/** Station-style code badge in the post type's line colour (needs a data-type ancestor). */
export type Props = { code: StationCode | undefined };

const { code } = Astro.props;
---

{
    code && (
        <span class="code" title={`${code.letter}·${code.number}`}>
            <b>{code.letter}</b>
            <span>{code.number}</span>
        </span>
    )
}
