---
import Logo from "./Logo.astro";
import Mosaic from "./Mosaic.astro";
---

<footer class="site-footer">
    <div class="footer-inner">
        <div class="footer-brand">
            <Logo size={15} strip />
            <p>
                Kaffekrus · Truls Henrik
                <span lang="ja">トルルスの庭</span>
            </p>
        </div>
        <nav class="footer-links" aria-label="Følg med">
            <a href="/rss.xml">RSS</a>
            <a href="mailto:post@truls.dev">E-post</a>
        </nav>
        <Mosaic
            class="footer-mosaic"
            seed="kaffekrus-footer"
            cols={12}
            rows={2}
            tile={14}
            density={0.9}
            anchor={[0.9, 0.5]}
            colors={["ink", "accent", "taupe", "cream", "vermilion", "teal"]}
        />
        <p class="footer-made">Skrevet i blok<span lang="ja">ブロックで書いた</span></p>
    </div>
</footer>

<style>
    .site-footer {
        border-top: 2px solid var(--ink);
        background: var(--paper);
    }

    .footer-inner {
        display: grid;
        grid-template-columns: auto auto minmax(0, 1fr) auto;
        align-items: center;
        gap: 18px 32px;
        max-width: var(--page-width);
        margin: 0 auto;
        padding: 22px var(--gutter) 28px;
    }

    .footer-brand {
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .footer-brand p,
    .footer-made {
        font-weight: 700;
        font-size: calc(12px * var(--ui-text));
        line-height: 1.3;
        letter-spacing: 0.1em;
        text-transform: uppercase;
    }

    .footer-brand [lang="ja"],
    .footer-made [lang="ja"] {
        display: block;
        font-weight: 500;
        letter-spacing: 0.06em;
        color: var(--muted);
    }

    .footer-links {
        display: flex;
        gap: 16px;
    }

    .footer-links a {
        font: 600 calc(12px * var(--ui-text)) var(--mono);
    }

    .footer-mosaic {
        justify-self: end;
        overflow: hidden;
        max-width: 100%;
    }

    .footer-made {
        font-family: var(--mono);
        font-weight: 600;
        letter-spacing: 0.02em;
        text-transform: none;
    }

    @media (max-width: 860px) {
        .footer-inner {
            grid-template-columns: minmax(0, 1fr) auto;
        }

        .footer-mosaic {
            grid-column: 1 / -1;
            justify-self: start;
            grid-row: 3;
        }
    }
</style>
