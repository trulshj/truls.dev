---
const currentPath = Astro.url.pathname;
const isActive = (path: string) =>
    path === "/" ? currentPath === "/" : currentPath === path || currentPath.startsWith(`${path}/`);

const links = [
    { href: "/", text: "Hjem", ja: "ホーム" },
    { href: "/garden", text: "Hagen", ja: "庭" },
    { href: "/about", text: "Om", ja: "概要" },
];
---

<div id="primary-nav" class="nav-links">
    {
        links.map((link) => (
            <a href={link.href} class:list={{ "is-on": isActive(link.href) }} aria-current={isActive(link.href) ? "page" : undefined}>
                <span class="nav-text">{link.text}</span>
                <span lang="ja">{link.ja}</span>
            </a>
        ))
    }
</div>

<style>
    .nav-links {
        display: none;
        position: absolute;
        top: calc(100% + 2px);
        left: 0;
        right: 0;
        flex-direction: column;
        padding: 8px var(--gutter) 16px;
        background: var(--paper);
        border-bottom: 2px solid var(--ink);
    }

    .nav-links.is-open {
        display: flex;
    }

    .nav-links a {
        display: flex;
        align-items: baseline;
        gap: 10px;
        padding: 12px 10px;
        color: var(--ink);
        text-decoration: none;
        font-weight: 700;
        font-size: calc(13px * var(--ui-text));
        line-height: 1.15;
        letter-spacing: 0.12em;
        text-transform: uppercase;
    }

    .nav-links [lang="ja"] {
        font-weight: 500;
        font-size: calc(11px * var(--ui-text));
        letter-spacing: 0.06em;
        color: var(--muted);
    }

    .nav-links a:hover {
        background: var(--accent);
    }

    .nav-links a:hover [lang="ja"] {
        color: var(--ink);
    }

    .nav-links a.is-on {
        background: var(--ink);
        color: var(--cream);
    }

    .nav-links a.is-on [lang="ja"] {
        color: var(--panel);
    }

    @media (min-width: 640px) {
        .nav-links {
            display: flex;
            position: static;
            flex-direction: row;
            gap: 4px;
            padding: 0;
            margin-left: auto;
            background: none;
            border: 0;
        }

        .nav-links a {
            flex-direction: column;
            gap: 3px;
            padding: 7px 12px 6px;
        }
    }
</style>
