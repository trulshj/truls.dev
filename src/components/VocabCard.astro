---
export type Props = {
    word: string;
    reading?: string;
    definition: string;
    example?: string;
    translation?: string;
    context?: string;
};

const { word, reading, definition, example, translation, context } = Astro.props;

function escapeHtml(s: string): string {
    return s
        .replace(/&/g, "&amp;")
        .replace(/</g, "&lt;")
        .replace(/>/g, "&gt;")
        .replace(/"/g, "&quot;")
        .replace(/'/g, "&#39;");
}

type RubyPart = { base: string; reading: string };

// Furigana, written as in blok: {洞窟|どうくつ}, or one reading per character: {漢字|かん|じ}
const FURIGANA = /\{([^\s{}|<>`\\]+)\|([^\s{}<>`\\]+)\}/g;

function rubyParts(base: string, readingText: string): RubyPart[] | null {
    if (!/[^\x00-\x7f]/.test(base)) return null;
    const readings = readingText.split("|");
    if (readings.some((r) => !r)) return null;
    const chars = [...base];
    if (readings.length > 1 && readings.length === chars.length) {
        return chars.map((ch, i) => ({ base: ch, reading: readings[i] }));
    }
    return [{ base, reading: readings.join("") }];
}

function rubyHtml(parts: RubyPart[]): string {
    const inner = parts
        .map((p) => `${escapeHtml(p.base)}<rp>(</rp><rt>${escapeHtml(p.reading)}</rt><rp>)</rp>`)
        .join("");
    return `<ruby>${inner}</ruby>`;
}

/** Text with furigana inside, as HTML. */
function withRuby(text: string): string {
    let out = "";
    let last = 0;
    for (const m of text.matchAll(FURIGANA)) {
        const parts = rubyParts(m[1], m[2]);
        if (!parts) continue;
        out += escapeHtml(text.slice(last, m.index)) + rubyHtml(parts);
        last = m.index! + m[0].length;
    }
    return out + escapeHtml(text.slice(last));
}

/**
 * The example sentence as HTML:
 * - {松明} highlights the word.
 * - {洞窟|どうくつ} adds furigana, highlighted when it's the card's word.
 * - {{覚|おぼ}えた} highlights a word with furigana inside.
 */
function parseExample(text: string): string {
    const parts: string[] = [];
    let last = 0;
    for (let i = text.indexOf("{"); i >= 0; i = text.indexOf("{", last)) {
        let depth = 0;
        let end = -1;
        for (let j = i; j < text.length && end < 0; j++) {
            if (text[j] === "{") depth++;
            else if (text[j] === "}" && --depth === 0) end = j;
        }
        if (end < 0) break;
        parts.push(escapeHtml(text.slice(last, i)));
        const inner = text.slice(i + 1, end);
        const furigana = /^([^\s{}|]+)\|([^\s{}]+)$/.exec(inner);
        const ruby = furigana && rubyParts(furigana[1], furigana[2]);
        if (ruby) parts.push(furigana![1] === word.trim() ? `<mark>${rubyHtml(ruby)}</mark>` : rubyHtml(ruby));
        else parts.push(`<mark>${withRuby(inner)}</mark>`);
        last = end + 1;
    }
    parts.push(escapeHtml(text.slice(last)));
    return parts.join("");
}

const processedExample = example ? parseExample(example) : "";
---

<figure class="vocab-card">
    <div class="vocab-word-box">
        {reading ? <ruby>{word}<rt>{reading}</rt></ruby> : word}
    </div>
    <div class="vocab-body">
        <p class="vocab-definition">{definition}</p>
        {example && <p class="vocab-example" lang="ja" set:html={processedExample} />}
        {translation && <p class="vocab-translation">{translation}</p>}
        {context && <p class="vocab-context">({context})</p>}
    </div>
</figure>

<style>
    .vocab-card {
        position: relative;
        background: var(--surface);
        border: 1px solid var(--border-strong);
        border-radius: 2px;
        box-shadow: var(--shadow);
        margin: var(--space-md) 0;
    }

    .vocab-word-box {
        position: absolute;
        top: -1px;
        left: var(--space-sm);
        font-family: "Noto Sans JP", sans-serif;
        font-size: 1.3rem;
        color: var(--ink);
        background: var(--surface);
        border: 1px solid var(--border-strong);
        border-radius: 2px;
        padding: 0.1em 0.5em;
        line-height: 1.4;
        /* Pull the word box up so it overlaps the card border */
        transform: translateY(-50%);
    }

    .vocab-word-box ruby rt {
        font-size: 0.55em;
        color: var(--muted);
    }

    .vocab-body {
        padding: 2.2rem var(--space-sm) var(--space-sm);
        display: flex;
        flex-direction: column;
        gap: 0.4rem;
    }

    .vocab-definition,
    .vocab-example,
    .vocab-translation,
    .vocab-context {
        margin: 0;
    }

    .vocab-definition {
        color: var(--ink);
    }

    .vocab-example {
        font-family: "Noto Sans JP", sans-serif;
        line-height: 2.2;
        color: var(--ink);
    }

    .vocab-translation {
        color: var(--muted);
        font-style: italic;
        font-size: 0.92rem;
    }

    .vocab-context {
        color: var(--muted);
        font-size: 0.88rem;
    }

    :global(.vocab-example ruby rt) {
        font-size: 0.55em;
        color: var(--muted);
    }

    :global(.vocab-example mark) {
        background: transparent;
        color: var(--leaf);
        font-weight: bold;
    }
</style>
