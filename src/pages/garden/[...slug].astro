---
import { render } from "astro:content";
import GardenItemLayout from "../../layouts/GardenItemLayout.astro";
import { publishedPosts, slugOf, stationCodes } from "../../lib/garden";

export async function getStaticPaths() {
    const posts = await publishedPosts();
    const codes = stationCodes(posts);
    return posts.map((post) => ({
        params: { slug: slugOf(post) },
        props: { post, code: codes.get(post.id) },
    }));
}

const { post, code } = Astro.props;
const { Content } = await render(post);
---

<GardenItemLayout post={post} code={code}>
    <Content />
</GardenItemLayout>
