---
import BaseLayout from "../../layouts/BaseLayout.astro";
import GardenCard from "../../components/GardenCard.astro";
import Mosaic from "../../components/Mosaic.astro";
import Stamp from "../../components/Stamp.astro";
import TitleBlock from "../../components/TitleBlock.astro";
import {
    LANG_LABELS,
    STATUS_LABELS,
    TYPE_LABELS,
    publishedPosts,
    stationCodes,
    titleSize,
    type GardenLang,
    type GardenStatus,
    type GardenType,
} from "../../lib/garden";

const posts = await publishedPosts();
const codes = stationCodes(posts);

// filters only offer what the garden has
const types = (Object.keys(TYPE_LABELS) as GardenType[]).filter((t) => posts.some((p) => p.data.type === t));
const langs = (Object.keys(LANG_LABELS) as GardenLang[]).filter((l) => posts.some((p) => p.data.lang === l));
const statuses = (Object.keys(STATUS_LABELS) as GardenStatus[]).filter((s) => posts.some((p) => p.data.status === s));
const count = (status: GardenStatus) => posts.filter((p) => p.data.status === status).length;

const feature = posts.length >= 4;
---

<BaseLayout pageTitle="Hagen">
    <section class="hero reveal">
        <TitleBlock lines={["Hagen"]} size={titleSize(["Hagen"], 900, 190, 74)} slab="庭" transitionName="title-garden">
            <Fragment slot="plate-top">Kaffekrus' hage</Fragment>
            <span slot="plate-bottom" lang="ja">デジタルガーデン</span>
        </TitleBlock>
        <Mosaic
            class="hero-mosaic"
            seed="kaffekrus-hagen"
            cols={12}
            rows={6}
            tile={24}
            density={0.8}
            anchor={[0.15, 0.6]}
            colors={["ink", "green", "taupe", "cream", "accent", "teal"]}
        />
        <p class="eyebrow hero-stats">
            <span class="dots">● ●</span>
            <span>
                {posts.length} innlegg · {count("seedling")} spirer · {count("evergreen")} modne
                <span lang="ja">投稿{posts.length}件・苗{count("seedling")}件・常緑{count("evergreen")}件</span>
            </span>
        </p>
    </section>

    <div class="page-intro">
        <p class="lead reveal">
            Et samlingspunkt for det jeg lager og tenker på. Tekst, kunst, fortellinger og notater. Noen ferske,
            noen under utvikling, noen modne.
        </p>

        <div class="filters reveal" aria-label="Filtrer innholdet">
            <div class="fgroup">
                <span class="flabel">Type<span lang="ja">種類</span></span>
                <button class="chip is-on" data-filter="type" data-value="all" aria-pressed="true">
                    Alle<span lang="ja">すべて</span>
                </button>
                {
                    types.map((t) => (
                        <button class="chip" data-filter="type" data-value={t} data-type={t} aria-pressed="false">
                            <i class="sw" />
                            {TYPE_LABELS[t].no}
                            <span lang="ja">{TYPE_LABELS[t].ja}</span>
                        </button>
                    ))
                }
            </div>
            {
                langs.length > 1 && (
                    <div class="fgroup">
                        <span class="flabel">Språk<span lang="ja">言語</span></span>
                        <button class="chip is-on" data-filter="lang" data-value="all" aria-pressed="true">
                            Alle
                        </button>
                        {langs.map((l) => (
                            <button class="chip" data-filter="lang" data-value={l} aria-pressed="false" title={LANG_LABELS[l].no}>
                                {LANG_LABELS[l].code}
                            </button>
                        ))}
                    </div>
                )
            }
            {
                statuses.length > 1 && (
                    <div class="fgroup">
                        <span class="flabel">Status<span lang="ja">状態</span></span>
                        <div class="fstamps">
                            {statuses.map((s) => (
                                <button
                                    class="stamp-btn"
                                    data-filter="status"
                                    data-value={s}
                                    aria-pressed="false"
                                    title={STATUS_LABELS[s].no}
                                >
                                    <Stamp status={s} size={34} />
                                </button>
                            ))}
                        </div>
                    </div>
                )
            }
        </div>
    </div>

    <div class="garden-grid garden-grid--four" id="garden-grid">
        {posts.map((post, i) => <GardenCard post={post} code={codes.get(post.id)} feature={feature && i === 0} />)}
    </div>

    {posts.length === 0 && <p class="no-results">Hagen er under anlegg. Snart vokser det noe her.</p>}
    <p class="no-results" id="no-results" hidden>
        Ingenting i hagen passer filteret.<span lang="ja">該当する投稿はありません</span>
    </p>
</BaseLayout>

<script>
    function initFilters() {
        const grid = document.getElementById("garden-grid");
        const noResults = document.getElementById("no-results");
        if (!grid || !noResults) return;

        const cards = [...grid.querySelectorAll<HTMLElement>(".card")];
        const buttons = [...document.querySelectorAll<HTMLButtonElement>("[data-filter]")];
        const active: Record<string, string> = { type: "all", lang: "all", status: "all" };

        function render() {
            let visible = 0;
            for (const card of cards) {
                const show = Object.entries(active).every(([key, value]) => value === "all" || card.dataset[key] === value);
                card.hidden = !show;
                if (show) visible++;
            }
            for (const button of buttons) {
                const on = active[button.dataset.filter!] === button.dataset.value;
                button.classList.toggle("is-on", on);
                button.setAttribute("aria-pressed", String(on));
            }
            noResults!.hidden = visible > 0 || cards.length === 0;
        }

        for (const button of buttons) {
            button.addEventListener("click", () => {
                const key = button.dataset.filter!;
                const value = button.dataset.value!;
                // status stamps have no "all" chip: clicking the active stamp clears it
                active[key] = key === "status" && active[key] === value ? "all" : value;
                render();
            });
        }
    }

    document.addEventListener("astro:page-load", initFilters);
</script>
